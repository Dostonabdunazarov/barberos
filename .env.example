# ─────────────────────────────────────────────────────────────────────────────
# Barberos — production environment variables (docker-compose.prod.yml).
# Скопируйте в `.env` рядом с docker-compose.prod.yml и заполните реальными значениями.
# `.env` в .gitignore — НЕ коммитить.
# Формат ключей ASP.NET Core: секция__подсекция__ключ (двойное подчёркивание).
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (образ postgres) ---
POSTGRES_DB=barberos
POSTGRES_USER=barberos
# Сгенерируйте: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Строка подключения API (Host=postgres — имя сервиса в compose-сети) ---
# Должна совпадать с POSTGRES_* выше.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=barberos;Username=barberos;Password=CHANGE_ME_strong_db_password

# --- JWT (КРИТИЧНО) ---
# Ключ подписи. Минимум 32 символа, рекомендуется 64+.
# Сгенерируйте: openssl rand -base64 48
Jwt__Key=CHANGE_ME_generate_a_long_random_secret_min_32_chars
Jwt__Issuer=barberos
Jwt__Audience=barberos-clients

# --- CORS: реальные origin(ы) SPA (fail-closed в Production, обязательны) ---
# Индексируемый массив: __0, __1, ...
Cors__Origins__0=https://barberos.example.com

# --- Разрешённые Host-заголовки (через ; ), защита от host-header атак ---
AllowedHosts=barberos.example.com

# --- Бутстрап первого админа (создаётся при старте, если админов ещё нет) ---
Bootstrap__Admin__Email=admin@barberos.example.com
# Сгенерируйте сильный уникальный пароль; при первом входе смените.
Bootstrap__Admin__Password=CHANGE_ME_strong_admin_password
Bootstrap__Admin__Name=Administrator

# --- Барбершоп (по желанию; дефолты в appsettings.json) ---
# Barbershop__TimeZone=Asia/Tashkent
# Barbershop__SlotStepMinutes=15
# Barbershop__LeadTimeMinutes=120

# --- Rate limiting (по желанию; дефолты в appsettings.json) ---
# RateLimiting__Login__PermitLimit=5
# RateLimiting__Booking__PermitLimit=10

# --- Frontend: базовый URL API для сборки Vite (если нужен) ---
# VITE_API_BASE_URL=https://barberos.example.com/api
