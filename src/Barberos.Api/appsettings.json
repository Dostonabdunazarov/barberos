{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=barberos;Username=barberos;Password=barberos"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "barberos",
    "Audience": "barberos-clients",
    "Key": "CHANGE_ME_use_user_secrets_or_env_min_32_chars_long",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Barbershop": {
    "TimeZone": "Asia/Tashkent",
    "SlotStepMinutes": 15
  }
}
